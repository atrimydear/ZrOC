@article{zhao2022a,
  title = {Electrospinning Fabrication and Ultra-Wideband Electromagnetic Wave Absorption Properties of {{CeO2}}/{{N-doped}} Carbon Nanofibers},
  author = {Zhao, Pei-Yan and Wang, Hui-Ya and Cai, Bo and Sun, Xiao-Bo and Hou, Zhi-Ling and Wu, Jun-Tao and Bai, Ming and Wang, Guang-Sheng},
  year = 2022,
  month = sep,
  journal = {Nano Res.},
  volume = {15},
  number = {9},
  pages = {7788--7796},
  issn = {1998-0000},
  doi = {10.1007/s12274-022-4675-x},
  urldate = {2026-03-04},
  abstract = {The impedance mismatch of carbon materials is a key factor limiting their widespread use in electromagnetic (EM) wave absorption. In this work, the novel CeO2/nitrogen-doped carbon (CeO2/N-C) nanofiber was prepared to solve the problem by electrospinning and sintering. X-ray diffraction (XRD), Raman, X-ray photoelectron spectroscopy (XPS), and transmission electron microscopy (TEM) analyses demonstrated CeO2 was successfully loaded onto the surface of partially graphitized carbon fibers. Different sintering temperatures change the graphitization degree of material, and the oxygen vacancy structure of CeO2 and defects from N doping optimize the impedance matching of the material. When the sintering temperature reaches 950 {$^\circ$}C, CeO2/N-C fiber possesses the minimum reflection loss (RLmin) value of -42.59 dB at 2.5 mm with a filler loading of only 3 wt.\% in polyvinylidene difluoride (PVDF). Meanwhile, the CeO2/N-C fiber achieves a surprising wideband (8.48 GHz) at a thickness of 2.5 mm, covering the whole Ku-band as well as 63\% of the X-band at the sintering temperature of 650 {$^\circ$}C. This work provides the research basis for widely commercial applications of carbon-based nanofiber absorbers.},
  langid = {english},
  keywords = {/,CeO2/N-doped carbon nanofiber,electromagnetic wave absorption,electrospinning,wideband},
  file = {D\:\\Knowledge\\Zoterolib\\storage\\QJ8R9PVA\\Zhao 等 - 2022 - Electrospinning fabrication and ultra-wideband electromagnetic wave absorption properties of CeO2N-.pdf;W\:\\Zoterolib\\SiZrOC\\Zhao 等 - 2022 - Electrospinning fabrication and ultra-wideband electromagnetic wave absorption properties of CeO2N-.pdf;D\:\\Knowledge\\Zoterolib\\storage\\ZFV8IWW9\\s12274-022-4675-x.html}
}

@article{zhou2019,
  title = {High Temperature Electromagnetic Wave Absorption Properties of {{SiCf}}/{{Si3N4}} Composite Induced by Different {{SiC}} Fibers},
  author = {Zhou, Qian and Yin, Xiaowei and Ye, Fang and Tang, Zhiming and Mo, Ran and Cheng, Laifei},
  year = 2019,
  month = apr,
  journal = {Ceram. Int.},
  volume = {45},
  number = {5},
  pages = {6514--6522},
  issn = {0272-8842},
  doi = {10.1016/j.ceramint.2018.12.142},
  urldate = {2026-01-24},
  abstract = {Ceramic matrix composites are potential electromagnetic (EM) wave absorbing materials for high temperature applications, and the critical problem is to obtain temperature insensitive absorption characteristics in broadband. In this study, the double layer SiC fiber reinforced composite with ZMI-SiCf/Si3N4 as lossy layer and SLF-SiCf/Si3N4 as impedance matching layer, has been constructed via the chemical vapor infiltration method. The designed SiCf/Si3N4 composite with the thickness of 4.2\,mm, which processes uniformly continuous microstructure and hierarchical permittivity, shows greatly enhanced EM wave absorbing performance of measured reflection loss less than -8\,dB in whole X and Ku band at the room temperature. The thickness dependent absorbing properties of the SiCf/Si3N4 composite are investigated, which are found to be highly correlated to the combining mode of the lossy and matching layers. Particularly, the temperature dependent absorption characteristics indicate that the fabricated SiCf/Si3N4 composite keeps relatively reliable high temperature absorbing performances up to 600\,{$^\circ$}C. The temperature insensitive absorption characteristics should be mostly attributed to the enhanced compensating effect of the decreased interfacial polarization loss with increasing temperature induced by multiple interfaces, as well as the unchanged geometric structure of the designed composite.},
  keywords = {,/,Ceramic matrix composites (CMCs),Electrical properties,EM wave absorbing structure,Interfacial polarization},
  file = {D\:\\Knowledge\\Zoterolib\\storage\\IGDC9NER\\Zhou 等 - 2019 - High temperature electromagnetic wave absorption properties of SiCfSi3N4 composite induced by diffe.pdf;D\:\\Knowledge\\Zoterolib\\storage\\X6K95XP3\\Zhou 等 - 2019 - High temperature electromagnetic wave absorption properties of SiCfSi3N4 composite induced by diffe.pdf;D\:\\Knowledge\\Zoterolib\\storage\\R6BUD7GC\\S0272884218335247.html}
}

@article{zhu2025,
  title = {{{ZrO2-interface-engineered SiC}} Nanofiber Aerogel with Integrated Hydrophobicity, Thermal Insulation, and Broadband Electromagnetic Wave Absorption},
  author = {Zhu, Hui and Weng, Xiaolong and Liao, Ming and Zheng, Jin and Bi, Mei},
  year = 2025,
  month = dec,
  journal = {Appl. Surf. Sci.},
  volume = {711},
  pages = {164079},
  issn = {0169-4332},
  doi = {10.1016/j.apsusc.2025.164079},
  abstract = {The multifunctionality of electromagnetic wave absorption (EMW) materials plays a crucial role in addressing the challenges posed by complex electromagnetic environments. Herein, a multifunctional ZrO2 interface engineering-modified SiC nanofiber aerogel (ZS-HNFA-x) that integrates elasticity, thermal insulation, and hydrophobicity has been successfully developed through an electrospinning-combined freeze-drying process. The aerogel is interconnected by an Si-O-Si network, forming a porous structure with complex interfaces, which not only promotes the formation of hydrophobic structures but also suppresses heat conduction while enhancing compressive strength. Specifically, the ZS-HNFA-1 possesses ultra-low density (6.6~mg{$\bullet$}cm-3), outstanding hydrophobic properties in various humid environments (hot/cold water, acidic, and alkaline corrosive liquids), excellent elasticity (with complete recovery from 60\% repeated strain), and remarkable thermal stability ({$\sim$}1200\textcelsius ) and insulation (24.07~W{$\cdot$}m-1{$\cdot$}K-1). Moreover, the ZrO2 interface-engineering strategy not only introduce abundant heterointerfaces but also significantly improve impedance matching characteristics, which consequently enhances the EMW absorption performance. Notably, the optimal ZS-HNFA-x possesses superior EMW absorption performance (the minimum reflection loss of~-53.2~dB and effective absorption bandwidth of 6.4~GHz at 2.4~mm thickness). This research offers valuable insights into the design of multifunctional ceramics with superior electromagnetic wave absorption properties for applications in harsh environments.},
  langid = {english},
  keywords = {_EndnoteXML import,//,Interface-engineering,Microwave absorption,Multifunctional Ceramic,ZrO/SiC hybrid nanofiber aerogel},
  file = {D\:\\Knowledge\\Zoterolib\\storage\\K7AQSWSL\\Zhu 等 - 2025 - ZrO2-interface-engineered SiC nanofiber aerogel with integrated hydrophobicity, thermal insulation,.pdf;D\:\\Knowledge\\Zoterolib\\storage\\LBUHR9FF\\Zhu 等 - 2025 - ZrO2-interface-engineered SiC nanofiber aerogel with integrated hydrophobicity, thermal insulation,.pdf}
}

@article{zhuang2020,
  title = {Realizing High Ceramic Yield and Low Shrinkage of In-Situ Formed Lightweight {{3D-SiC}}({{rGO}})Px Polymer-Derived Ceramics with Excellent Fracture Toughness},
  author = {Zhuang, Kun and Lin, Shuyu and Huang, Wenyan and Liao, Liang and Zheng, Yinong and Li, Lingjie and Ning, Zhonghao and Jin, Chao and Lan, Siqi and Zhang, Yinggan and Yao, Rongqian},
  year = 2020,
  month = dec,
  journal = {Ceram. Int.},
  volume = {46},
  number = {17},
  pages = {27426--27436},
  issn = {0272-8842},
  doi = {10.1016/j.ceramint.2020.07.229},
  abstract = {Integration of high ceramic yield, low shrinkage and excellent fracture toughness in polymer-derived ceramics (PDCs) is challenging. Highly cross-linked polycarbosilane-vinyltriethoxysilane-graphene oxide (PCS-VTES-GO, PVG) precursors spontaneously interact with dense high-strength SiC(rGO)p fillers for abundant Si-dangling bonds at their interfaces. Herein, an ingenious strategy via re-pyrolysis process of ball-milling-induced SiC(rGO)p/PVG blends is proposed to fabricate 3D-SiC(rGO)px PDCs. The in-situ formed innovative three-dimensional (3D) honeycomb cellular net-like structure, with dense {$\beta$}-SiC(SiO2)/SiOxCy/Cfree(rGO) framework providing high strength while tiny micro-sized pores relaxing stress at the tip, effectively improves molding process, ceramic yield and mechanical properties of PDCs. Particularly, lightweight 3D-SiC(rGO)p0.6 PDCs display dense surface, satisfactory hardness (3.96~GPa) and excellent fracture toughness (3.21~MPa~m1/2), especially high ceramic yield (94.49\%) and low linear shrinkage (5.00\%), realizing outstanding values ever reported for PDCs to the best of our knowledge. During re-pyrolysis process, they have struck perfect balance and achieved a combination of equal volume of inwardly shrinking PVG precursors and outwardly expanding SiC(rGO)p fillers. For the first time, such synergistic effects of flexible PVG with rigid SiC(rGO)p in this way pave a practical route toward reliable mass-produced 3D-SiC(rGO)px PDCs with potential applications in emerging aerospace propulsion components.},
  langid = {english},
  keywords = {Graphene oxide,Polycarbosilane,Polymer-derived ceramics,SiC},
  file = {D:\Knowledge\Zoterolib\storage\L6949KA7\Zhuang 等 - 2020 - Realizing high ceramic yield and low shrinkage of in-situ formed lightweight 3D-SiC(rGO)px polymer-d.pdf}
}

@article{ziabari2010,
  title = {A New Approach for Optimization of Electrospun Nanofiber Formation Process},
  author = {Ziabari, Mohammad and Mottaghitalab, Vahid and Haghi, Akbar Khodaparast},
  year = 2010,
  month = jan,
  journal = {Korean J. Chem. Eng.},
  volume = {27},
  number = {1},
  pages = {340--354},
  issn = {1975-7220},
  doi = {10.1007/s11814-009-0309-1},
  urldate = {2026-04-22},
  abstract = {Precise control of fiber diameter during electrospinning is very crucial for many applications. A systematic and quantitative study on the effects of processing variables enables us to control the properties of electrospun nanofibers. In this contribution, response surface methodology (RSM) was employed to quantitatively investigate the simultaneous effects of four of the most important parameters, namely solution concentration (C), spinning distance (d), applied voltage (V) and volume flow rate (Q), on mean fiber diameter (MFD) as well as standard deviation of fiber diameter (StdFD) in electrospinning of polyvinyl alcohol (PVA) nanofibers.},
  langid = {english},
  keywords = {Electrospinning,Fiber Diameter,Nanofibers,Processing Variables,Response Surface Methodology},
  file = {D\:\\Knowledge\\Zoterolib\\storage\\IL5UJKLV\\Ziabari 等 - 2010 - A new approach for optimization of electrospun nanofiber formation process.pdf;D\:\\Knowledge\\Zoterolib\\storage\\W9KYZ2HA\\Ziabari 等 - 2010 - A new approach for optimization of electrospun nanofiber formation process.pdf}
}

