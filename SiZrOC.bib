@article{zhang2021a,
  title = {Multi-Phase {{SiZrOC}} Nanofibers with Outstanding Flexibility and Stability for Thermal Insulation up to 1400 {$^\circ$}{{C}}},
  author = {Zhang, Xiaoshan and Wang, Bing and Wu, Nan and Han, Cheng and Wang, Yingde},
  year = 2021,
  month = apr,
  journal = {Chem. Eng. J.},
  volume = {410},
  pages = {128304},
  issn = {1385-8947},
  doi = {10.1016/j.cej.2020.128304},
  abstract = {Ceramic fibers are one of the most important high-temperature thermal insulating materials for application in the harsh environment. However, the practical use of traditional ceramic fibers has been largely impeded by their poor thermal stability or high thermal conductivity at high-temperatures. Here, multi-phase SiZrOC (SiOxCy, SiO2, ZrO2, ZrSiO4 and C) nanofiber (NF) was rationally designed and prepared according to the intrinsic factors of these phases with lower heat transfer effects (significant phonon scattering and infrared shielding) that contributes to the high-temperature thermal insulation performance in ceramic fibers. Owing to the unique multi-phase microstructure, the obtained SiZrOC NFs exhibit ultralow thermal conductivity (\textasciitilde 0.043~W~m-1 K-1 at 25~{$^\circ$}C and \textasciitilde 0. 233~W~m-1 K-1 at 1400~{$^\circ$}C), high flexibility, good mechanical strength, excellent fire resistance and thermal stability even up to 1400~{$^\circ$}C, which makes it an ideal high-temperature thermal insulator especially for applications under extreme conditions. This work not only presents with the fabrication of a prosperous material for high-temperature thermal insulation but also offers a novel strategy for developing a wider range of high-temperature thermal insulating materials.},
  langid = {english},
  keywords = {Ceramic nanofiber,Flexibility,Multi-phase,SiZrOC,Thermal insulation,Thermal stability},
  file = {D\:\\Knowledge\\Zoterolib\\storage\\NSFY5D8Q\\Zhang 等 - 2021 - Multi-phase SiZrOC nanofibers with outstanding flexibility and stability for thermal insulation up t.pdf;D\:\\Knowledge\\Zoterolib\\storage\\ZQQWK5C6\\Zhang 等 - 2021 - Multi-phase SiZrOC nanofibers with outstanding flexibility and stability for thermal insulation up t.pdf}
