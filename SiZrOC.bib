@misc{AdvancesAerogelMaterials,
  title = {Advances in {{Aerogel Materials}} for {{Energy}} and {{Environmental Sustainability}}},
  author = {Ma, Zhiyao and Fan, Yaowen and Li, Boxiao and Manshaii, Farid and Zhou, Jian and Chen, Jun},
  year = 2026,
  month = aug,
  journal = {Advanced Materials},
  doi = {10.1002/adma.74744},
  urldate = {2026-09-01},
  abstract = {Aerogels combine exceptional thermal insulation with low density, high porosity and structural versatility, but are constrained by high cost and limited scalability (especially supercritical CO2 drying). This review highlights scalable and cost-effective aerogel fabrication (ambient-pressure drying, templating, top-down manufacturing, CVD, solution spinning), presents a unified perspective on the thermal transport physics of porous materials (solid conduction, gas conduction, convection, thermal radiation), and showcases emerging applications beyond insulation: moisture/water-driven energy harvesting, oil-water separation, high-temperature acoustic insulation, and thermoregulating smart textiles.},
  langid = {english},
  keywords = {,-2026-09},
