@article{zuo2019,
  title = {Porous Magnetic Carbon Nanofibers ({{P-CNF}}/{{Fe}}) for Low-Frequency Electromagnetic Wave Absorption Synthesized by Electrospinning},
  author = {Zuo, Xiaodan and Xu, Pan and Zhang, Chongyang and Li, Mengzhu and Jiang, Xiangyu and Yue, Xigui},
  year = 2019,
  month = mar,
  journal = {Ceram. Int.},
  volume = {45},
  number = {4},
  pages = {4474--4481},
  issn = {0272-8842},
  doi = {10.1016/j.ceramint.2018.11.127},
  abstract = {The recent criteria to evaluate electromagnetic wave absorber include low density, strong absorbency, wide absorption bandwidth and thin absorber thickness, but its performance at low frequencies is always ignored. In this paper, the porous magnetic carbon nanofibers (P-CNF/Fe) for high-efficient electromagnetic wave absorption at low frequencies were fabricated by electrospinning followed by stabilization and carbonization. With the introduction of porous nanostructure, the permittivity of carbon nanofibers was decreased at low frequency and the impedance matching of permittivity and permeability was realized. The electromagnetic absorbing properties were investigated in detail. The minimum reflection coefficient reaches -44.86\,dB at 4.42\,GHz, and the widest effective absorption bandwidth (EAB) in the frequency was 3.28 range from 12.96 to 16.24\,GHz. Consequently, considering the EM wave absorption performance, P-CNF/Fe synthesized in this work can be a promising candidate in the field of EM wave attenuation.},
  langid = {english},
  keywords = {Carbon nanofiber,Electromagnetic wave absorption,Low-frequency absorption,Porous nanostructure},
  file = {D\:\\Knowledge\\Zoterolib\\storage\\7LQ72G8W\\Zuo 等 - 2019 - Porous magnetic carbon nanofibers (P-CNFFe) for low-frequency electromagnetic wave absorption synth.pdf;D\:\\Knowledge\\Zoterolib\\storage\\9HP5TKIA\\Zuo 等 - 2019 - Porous magnetic carbon nanofibers (P-CNFFe) for low-frequency electromagnetic wave absorption synth.pdf;D\:\\Knowledge\\Zoterolib\\storage\\SZF5NIB7\\Zuo 等 - 2019 - Porous magnetic carbon nanofibers (P-CNFFe) for low-frequency electromagnetic wave absorption synth.pdf}
}

@article{zvonareva2023,
  title = {Proton-Conducting Barium Stannate for High-Temperature Purposes: {{A}} Brief Review},
  shorttitle = {Proton-Conducting Barium Stannate for High-Temperature Purposes},
  author = {Zvonareva, Inna A. and Medvedev, Dmitry A.},
  year = 2023,
  month = feb,
  journal = {Journal of the European Ceramic Society},
  volume = {43},
  number = {2},
  pages = {198--207},
  issn = {09552219},
  doi = {10.1016/j.jeurceramsoc.2022.10.049},
  urldate = {2025-12-29},
  abstract = {Solid oxide fuel cells (SOFCs) are highly efficient energy conversion devices. However, the use of traditional yttria-stabilized zirconia materials for SOFC electrolytes requires high operating temperatures, which limits their lifetime. Although serious efforts have been made to develop proton-conducting electrolyte materials as means for reducing SOFC operating temperatures, the design of materials that combine high conductivity with good tolerance towards aggressive operating conditions continues to present a significant challenge. This study presents a detailed analysis of the ceramic features, synthesis conditions, chemical stability, electrical transport, and hydration properties of a cubic perovskite oxide of barium stannate recently identified as a suitable material for proton-conducting electrolytes. The presented analysis confirms that BaSnO3-based oxides can be considered alongside existing classes of proton-conducting materials as comprising a relatively new class of ceramic materials for various electrochemical applications.},
  langid = {english},
  file = {D\:\\Knowledge\\Zoterolib\\storage\\B9I77X4H\\Zvonareva和Medvedev - 2023 - Proton-conducting barium stannate for high-temperature purposes A brief review.no_watermark.zh-CN.dual.pdf;D\:\\Knowledge\\Zoterolib\\storage\\E2NP76VK\\Zvonareva和Medvedev - 2023 - Proton-conducting barium stannate for high-temperature purposes A brief review.pdf;D\:\\Knowledge\\Zoterolib\\storage\\GD9J3E88\\Zvonareva和Medvedev - 2023 - Proton-conducting barium stannate for high-temperature purposes A brief review.no_watermark.zh-CN.mono.pdf}
}
